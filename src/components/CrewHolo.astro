---
// src/components/CrewHolo.astro
// One of a past crew as a hologram bust: their cut-out portrait projected
// in blue, with scan lines, a flicker, and a fade at the chest the way the
// films' holograms trail off. Under the Light skin it's a plain grey
// portrait.
//
// The scan lines are clipped to the person, so a cut-out (a PNG with a
// transparent background) is what makes it read as a hologram rather
// than a screen. Until a photo arrives, a silhouette stands in.
import type { CrewMember } from '../data/crew';

interface Props {
  member: CrewMember;
  /** Place in its row: staggers the projection */
  index: number;
}

const { member, index } = Astro.props;

const SILHOUETTE =
  'M50 22C40.5 22 34 29.5 34 40c0 7.5 3 13.5 7 17v6c-11 3-24 7-28.5 15-3 5-4 14-4 32h83c0-18-1-27-4-32-4.5-8-17.5-12-28.5-15v-6c4-3.5 7-9.5 7-17 0-10.5-6.5-18-16-18Z';
// Written pre-encoded: a literal SVG tag in the frontmatter trips the compiler
const standIn = `data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 110'%3E%3Cpath d='${SILHOUETTE}'/%3E%3C/svg%3E`;
const shape = `url("${member.photo ?? standIn}")`;

// The Light skin's backdrop for the stand-in, as on the cards
const skies = [
  ['#e7b56d', '#8a4722'],
  ['#d9e8ef', '#56768e'],
  ['#86a14f', '#1b2c14'],
  ['#f4a86a', '#9b3a2a'],
  ['#8c80e3', '#1c1842'],
  ['#58c2cf', '#0c4350'],
  ['#f0703a', '#3d0e07'],
  ['#9aa78a', '#28311f'],
];
const seed = [...member.name].reduce((n, c) => n + c.charCodeAt(0), 0);
const [skyA, skyB] = skies[seed % skies.length];
---

<li
  class:list={['holo', { 'holo--stand-in': !member.photo }]}
  style={`--i: ${index}; --shape: ${shape}; --sky-a: ${skyA}; --sky-b: ${skyB}`}
>
  <span class="holo__figure" aria-hidden="true">
    {member.photo ? (
      <img src={member.photo} alt="" loading="lazy" decoding="async" />
    ) : (
      <svg viewBox="0 0 100 110" preserveAspectRatio="xMidYMax meet" focusable="false">
        <path d={SILHOUETTE} />
      </svg>
    )}
  </span>
  <span class="holo__name">{member.name}</span>
  <span class="holo__role">{member.role}</span>
</li>

<style>
  /* Shared structure, and the Light skin as it stands */

  .holo {
    --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
    flex: none;
    width: var(--card-w, 9rem);
    list-style: none;
  }

  .holo__figure {
    position: relative;
    display: block;
    aspect-ratio: 100 / 110;
    overflow: hidden;
    border-radius: 2px;
    background: #16171b;
    filter: grayscale(1);
  }

  :global([data-skin='light']) .holo--stand-in .holo__figure {
    background: linear-gradient(to bottom, var(--sky-a), var(--sky-b));
  }

  .holo__figure img,
  .holo__figure svg {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: 50% 100%;
  }

  .holo__figure path { fill: #0b0e15; }

  .holo__name {
    display: block;
    margin-top: 0.8rem;
    color: rgba(254, 218, 74, 0.85);
    font-size: 0.86rem;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-wrap: balance;
  }

  .holo__role {
    display: block;
    margin-top: 0.3rem;
    color: #4bd5ee;
    font-size: 0.66rem;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  /* ================= Homage: projected ================= */

  :global([data-skin='homage']) .holo { text-align: center; }

  /* Fades out at the chest; the glow follows the figure's own outline */
  :global([data-skin='homage']) .holo__figure {
    overflow: visible;
    background: none;
    filter: drop-shadow(0 0 0.55rem rgba(75, 213, 238, 0.5));
    -webkit-mask-image: linear-gradient(to bottom, #000 58%, transparent 97%);
    mask-image: linear-gradient(to bottom, #000 58%, transparent 97%);
  }

  :global([data-skin='homage']) .holo__figure path {
    fill: rgba(75, 213, 238, 0.34);
    stroke: rgba(233, 251, 255, 0.85);
    stroke-width: 0.7;
  }

  :global([data-skin='homage']) .holo__figure img {
    filter: grayscale(1) sepia(1) hue-rotate(150deg) saturate(2.6) brightness(1.1) contrast(1.1);
    opacity: 0.8;
  }

  /* Light falling on the face, and the scan lines with a brighter band
     rolling up through them, all clipped to the person */
  :global([data-skin='homage']) .holo__figure::before,
  :global([data-skin='homage']) .holo__figure::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    -webkit-mask: var(--shape) 50% 100% / contain no-repeat;
    mask: var(--shape) 50% 100% / contain no-repeat;
  }

  :global([data-skin='homage']) .holo__figure::before {
    background: radial-gradient(34% 26% at 50% 34%, rgba(233, 251, 255, 0.4), transparent);
  }

  :global([data-skin='homage']) .holo__figure::after {
    background:
      linear-gradient(to bottom, transparent, rgba(233, 251, 255, 0.45), transparent) 0 -60% / 100% 26% no-repeat,
      repeating-linear-gradient(to bottom, rgba(233, 251, 255, 0.24) 0 1px, transparent 1px 3px);
  }

  :global([data-skin='homage']) .holo__name {
    margin-top: 0.35rem;
    color: #cff6fd;
    text-shadow: 0 0 0.6rem rgba(75, 213, 238, 0.45);
  }

  :global([data-skin='homage']) .holo__role { color: rgba(75, 213, 238, 0.85); }

  @media (prefers-reduced-motion: no-preference) {
    :global([data-skin='homage']) .holo__figure {
      animation:
        holo-flicker 6s steps(1, end) infinite,
        holo-glitch 9s steps(1, end) infinite;
      animation-delay: calc(var(--i) * -1.7s), calc(var(--i) * -2.9s);
    }

    :global([data-skin='homage']) .holo__figure::after {
      animation: holo-band 3.8s linear infinite;
      animation-delay: calc(var(--i) * -1.1s);
    }
  }

  @keyframes holo-flicker {
    0%, 100% { opacity: 0.92; }
    4% { opacity: 0.6; }
    5% { opacity: 0.9; }
    41% { opacity: 0.82; }
    42% { opacity: 0.95; }
    77% { opacity: 0.68; }
    78% { opacity: 0.92; }
  }

  /* Now and then the signal slips sideways for a frame */
  @keyframes holo-glitch {
    0%, 100% { transform: none; }
    62% { transform: translateX(3px) skewX(-5deg); }
    63% { transform: translateX(-2px); }
    64% { transform: none; }
  }

  @keyframes holo-band {
    from { background-position: 0 -60%, 0 0; }
    to { background-position: 0 160%, 0 0; }
  }

  /* ---- Tuned in as the row scrolls into view (Crew.astro arms this) ---- */

  :global(.is-dealing [data-deal]) .holo {
    transform-origin: 50% 100%;
    transition:
      opacity 0.6s ease calc(var(--i) * 90ms),
      transform 0.7s var(--ease-out) calc(var(--i) * 90ms),
      filter 0.7s ease calc(var(--i) * 90ms);
  }

  :global(.is-dealing [data-deal]:not(.is-dealt)) .holo {
    opacity: 0;
    transform: var(--deal-from, translateY(2.5rem));
  }

  :global([data-skin='homage']) .holo { --deal-from: scaleY(0.04); }

  :global(.is-dealing[data-skin='homage'] [data-deal]:not(.is-dealt)) .holo { filter: brightness(3); }
</style>
