---
// src/components/Crew.astro
// The crew as this year's series of trading cards: heads as the large
// cards, deputies below. Earlier crews have a page of their own, linked
// from the foot of the section; see LegacyCrews.astro.
import Section from './Section.astro';
import CrewCard from './CrewCard.astro';
import { heads, deputies, series, isSample } from '../data/crew';

const pad = (n: number) => String(n).padStart(2, '0');
---

<Section id="crew" label="Crew">
  <div class="crew" data-crew>
    <header class="crew__head">
      <h2 class="crew__heading">Crew</h2>
      <div class="crew__notes">
        {isSample && <p class="crew__note">Sample crew. Replace them in src/data/crew.ts</p>}
        <p class="crew__note crew__note--flip">Tap a card to turn it over</p>
      </div>
    </header>

    <div class="crew__body">
      <div class="crew__tier crew__tier--heads">
        <h3 class="crew__tier-title">Heads</h3>
        <div class="crew__row" data-deal>
          <ol class="crew__cards" role="list">
            {heads.map((m, i) => (
              <CrewCard member={m} number={pad(i + 1)} series={series} tier="head" index={i} />
            ))}
          </ol>
        </div>
      </div>

      <div class="crew__tier crew__tier--deputies">
        <h3 class="crew__tier-title">Deputies</h3>
        <div class="crew__row" data-deal>
          <ol class="crew__cards" role="list">
            {deputies.map((m, i) => (
              <CrewCard member={m} number={pad(heads.length + i + 1)} series={series} tier="deputy" index={i} />
            ))}
          </ol>
        </div>
      </div>

      <p class="crew__archive">
        <a class="crew__archive-link" href="/legacy">
          Past crews<span aria-hidden="true"> →</span>
        </a>
      </p>
    </div>
  </div>
</Section>

<style>
  .crew {
    --yellow: #feda4a;
    --yellow-dim: rgba(254, 218, 74, 0.72);
    --blue: #4bd5ee;
    --core: #e9fbff;
    --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
    box-sizing: border-box;
    max-width: 72rem;
    margin: 0 auto;
    padding: clamp(4.5rem, 12vh, 7.5rem) clamp(1rem, 4vw, 2.5rem) clamp(4rem, 10vh, 6.5rem);
  }

  /* ---------- Heading ---------- */

  .crew__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    column-gap: 1.5rem;
    row-gap: 0.75rem;
    margin-bottom: clamp(2.75rem, 7vh, 4.5rem);
  }

  .crew__heading {
    margin: 0;
    color: var(--yellow);
    font-family: 'Star Jedi', 'Anton', sans-serif;
    font-weight: 400;
    font-size: clamp(2.25rem, 7vw, 4.5rem);
    line-height: 1;
    letter-spacing: 0.04em;
    text-transform: lowercase; /* Star Jedi's clean letters; see global.css */
  }

  .crew__notes {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .crew__note {
    margin: 0;
    color: rgba(254, 218, 74, 0.6);
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  /* ---------- Rows of cards ---------- */

  .crew__body { container-type: inline-size; }

  .crew__tier {
    --gap: clamp(0.75rem, 2.4cqw, 1.75rem);
  }

  /* Narrow: heads and deputies two across */
  .crew__tier--heads { --card-w: min(15rem, (100cqw - var(--gap)) / 2); }
  .crew__tier--deputies { --card-w: min(12.5rem, (100cqw - var(--gap)) / 2); }

  /* Wide: every head on one row, deputies up to five across on the next */
  @container (min-width: 50rem) {
    .crew__tier--heads { --card-w: min(15rem, (100cqw - 3 * var(--gap)) / 4); }
    .crew__tier--deputies { --card-w: min(12.5rem, (100cqw - 4 * var(--gap)) / 5); }
  }

  .crew__tier + .crew__tier { margin-top: clamp(3rem, 8vh, 5rem); }

  .crew__tier-title {
    display: flex;
    align-items: center;
    gap: 1.1rem;
    margin: 0 0 clamp(1.5rem, 4vh, 2.25rem);
    color: var(--yellow-dim);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .crew__tier-title::before,
  .crew__tier-title::after {
    content: '';
    flex: 1;
    height: 1px;
    background: rgba(254, 218, 74, 0.18);
  }

  .crew__row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: flex-start;
    gap: clamp(1.5rem, 4vw, 2.5rem) var(--gap);
  }

  /* The list keeps its semantics; its cards join the row's flow */
  .crew__cards {
    display: contents;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* ---------- Out to the past crews ---------- */

  .crew__archive {
    margin: clamp(3rem, 8vh, 5rem) 0 0;
    text-align: center;
  }

  .crew__archive-link {
    padding-bottom: 0.25rem;
    border-bottom: 1px solid rgba(254, 218, 74, 0.3);
    color: var(--yellow-dim);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    text-decoration: none;
    transition: color 0.2s, border-color 0.2s;
  }

  .crew__archive-link:hover {
    color: var(--yellow);
    border-color: var(--yellow);
  }
</style>

<script>
  function initCrew() {
    const crew = document.querySelector<HTMLElement>('[data-crew]');
    if (!crew || crew.dataset.ready === 'true') return;
    crew.dataset.ready = 'true';

    const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    /* ---- Turning cards over. Every card starts face up, with its back
       taken out of the page until it is turned. ---- */
    const flip = (card: HTMLElement, on = !card.classList.contains('is-flipped')) => {
      card.classList.toggle('is-flipped', on);
      card.querySelector('[data-card-flip]')?.setAttribute('aria-pressed', String(on));
      const back = card.querySelector<HTMLElement>('[data-card-back]');
      if (back) back.inert = !on;
    };

    for (const c of crew.querySelectorAll<HTMLElement>('[data-flippable]')) flip(c, false);

    /* ---- Turn a card over: the corner button for keyboards, anywhere on
       the card for pointers ---- */
    crew.addEventListener('click', (e) => {
      const target = e.target as Element;
      if (target.closest('a')) return;
      const card = target.closest<HTMLElement>('[data-flippable]');
      if (card) flip(card);
    });

    /* ---- Deal each row in as it scrolls into view ---- */
    if (!still && 'IntersectionObserver' in window) {
      crew.classList.add('is-dealing');
      const io = new IntersectionObserver(
        (entries) => {
          for (const en of entries) {
            if (!en.isIntersecting) continue;
            en.target.classList.add('is-dealt');
            io.unobserve(en.target);
          }
        },
        // The moment any of a row shows, so there's never a visible gap
        // where cards are about to be
        { threshold: 0 },
      );
      for (const row of crew.querySelectorAll('[data-deal]')) io.observe(row);
    }
  }

  initCrew();
  document.addEventListener('astro:page-load', initCrew);
</script>
