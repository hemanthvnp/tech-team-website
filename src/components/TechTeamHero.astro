---
// src/components/TechTeamHero.astro
// A Star Wars style hero, in two beats:
//   1. the yellow story crawl, tilted away into deep space
//   2. TECH TEAM rides up the same plane behind the story, then flattens
//      square to the camera at screen centre and shifts colour
// Pure CSS animation + a canvas starfield. No dependencies.

interface Props {
  titleTop?: string;
  titleBottom?: string;
  episode?: string;
  subtitle?: string;
  paragraphs?: string[];
  names?: string;
  tagline?: string;
  /** Optional path to your own fanfare, e.g. "/audio/theme.mp3". Never autoplays. */
  audioSrc?: string;
}

const {
  titleTop = 'TECH',
  titleBottom = 'TEAM',
  episode = 'Episode I',
  subtitle = 'THE LEGACY MENACE',
  paragraphs = [
    'It is a period of rapid development. Rebel coders, striking from a hidden repo, have won their first victory against the evil legacy codebase.',
    'During the battle, spies managed to steal secret source code to the ultimate framework, an IDE with enough power to destroy an entire sprint.',
    'Pursued by sinister deadlines, the GT-Planar squad races home aboard main, custodian of the commits that can save their release and restore freedom to the galaxy....',
  ],
  names = 'Prem Dharshan · Mithun Karthik · Ajay H · Dinesh · Jithendra · Hemanth · Nithiish',
  tagline = '2026',
  audioSrc,
} = Astro.props;
---

<section class="sw" id="tech-team-hero" aria-label="Tech Team intro" data-intro-root>
  <canvas class="sw__stars" aria-hidden="true"></canvas>

  <!-- Draws nothing. Its animation starts on the beat the title begins to
       turn blue, which is how the page hears about that moment. -->
  <span class="sw__cue" aria-hidden="true"></span>

  <!-- Beat 2 sits underneath, so the story passes in front of the title -->
  <div class="sw__title-layer">
    <h1 class="sw__title">
      <span class="sw__title-line">{titleTop}</span>
      <span class="sw__title-line">{titleBottom}</span>
    </h1>
  </div>

  <!-- Beat 1: the story -->
  <div class="sw__viewport" aria-hidden="true">
    <div class="sw__crawl">
      <p class="sw__episode">{episode}</p>
      <p class="sw__subtitle">{subtitle}</p>
      {paragraphs.map((text) => <p class="sw__para">{text}</p>)}
      <p class="sw__names">{names}</p>
    </div>
  </div>

  <!-- Fades in under the flattened title once the sequence lands -->
  <div class="sw__outro">
    <p class="sw__tagline">{tagline}</p>
    <div class="sw__actions"><slot /></div>
  </div>

  <!-- Top right. Skip and Replay never co-exist, so they share the slot:
       Skip while the sequence runs, Replay once it has landed. -->
  <div class="sw__hud">
    <button class="sw__btn" type="button" data-action="skip">Skip</button>
    <button class="sw__btn" type="button" data-action="replay">Replay</button>

    <label class="sw__speed">
      <span class="sw__speed-head">
        Speed <output class="sw__speed-value" data-speed-out>1.5&#215;</output>
      </span>
      <!-- value must match --speed in the stylesheet below -->
      <input
        class="sw__speed-range"
        type="range"
        min="0.5"
        max="4"
        step="0.1"
        value="1.5"
        data-action="speed"
        aria-label="Playback speed"
      />
    </label>
  </div>

  {audioSrc && (
    <div class="sw__controls">
      <button class="sw__btn" type="button" data-action="sound" aria-pressed="false">
        <span data-sound-label>Play with sound</span>
      </button>
    </div>
  )}

  {audioSrc && <audio class="sw__audio" src={audioSrc} preload="none"></audio>}
</section>

<style>
  /* Faces (News Cycle, Anton, Star Jedi) are loaded site-wide by SiteLayout. */

  .sw {
    /* ---- Timing. The title rides in about a line behind the story's last
       line and keeps pace with it up the screen, then comes forward as the
       story dissolves. The title's delay sets the gap; its duration sets
       the pace, so change the two together.
       --speed re-times the whole sequence at once; raise it to go faster. */
    --speed: 1.5;
    --t-crawl-delay: calc(0.8s / var(--speed));
    --t-crawl: calc(38s / var(--speed));
    --t-title-delay: calc(9s / var(--speed));
    --t-title: calc(29s / var(--speed));
    /* Inside the title's own timeline: it travels until 70%, flattens by 92%. */

    /* ---- Geometry. Both planes share a tilt and an eye point; only the
       focal length differs (see --crawl-perspective). ----
       Change --tilt and --title-tan together: --title-tan is tan(--tilt). */
    --tilt: 34deg;
    --title-tan: 0.6745;
    --perspective: 420px;
    --vanish: 45%;

    /* The story gets a shorter focal length than the title, so its plane
       converges hard: text shrinks toward the vanishing point instead of
       being faded out while it is still big. In vh so the horizon lands at
       the same place on any viewport (it sits at --vanish minus
       --crawl-perspective / tan(--tilt), which is off the top by a hair).
       The title keeps --perspective: its travel is tuned against that. */
    --crawl-perspective: 35vh;

    /* Story travel, as a % of the crawl block's own height. Far enough that
       the last line climbs all the way to the vanishing point and out; the
       plane does the shrinking, so there is no translateZ any more. Pushing
       the block back along the plane normal would drag it DOWN the screen,
       away from the vanishing point, which is the opposite of what we want. */
    --crawl-from: 105%;
    --crawl-to: -200%;

    /* Title travel: starts fully below the screen, arrives dead centre.
       Translating down the tilted plane also swings the title toward the
       camera, which magnifies it enough to peek back over the bottom edge.
       --title-from-z is exactly -tan(--tilt) of the travel, which cancels
       that out: the start sits at scale 1, so it clears the edge at any
       viewport height. --title-depth is how far back it has drifted by the
       time it lands at centre. */
    --title-from: 90vh;
    --title-from-z: calc(var(--title-from) * var(--title-tan) * -1);
    --title-depth: -250px;
    --title-rest: -7vh; /* final offset, leaves room for the tagline below */

    /* Star Jedi is the logo lettering itself, so it is set undistorted.
       These stay as knobs, but stretching this face fights it: the y value
       is what overflowed the 0.95 line advance and made the two words
       collide. Raise --title-leading before reaching for --title-stretch-y. */
    --title-stretch-x: 1;
    --title-stretch-y: 1;
    --title-leading: 0.92;

    /* ---- Colour ---- */
    --yellow: #feda4a;
    --story-color: #fdbc1c; /* #eca902's amber, lifted in lightness */
    --title-color-end: #4bd5ee;

    position: relative;
    width: 100%;
    height: 100vh;
    height: 100svh;
    overflow: hidden;
    background: #000;
    isolation: isolate;
  }

  /* Tall screens: the title covers ground faster than the story does, so it
     rides longer to hold the same gap behind it */
  @media (max-aspect-ratio: 3/4) {
    .sw {
      --t-title-delay: calc(7.5s / var(--speed));
      --t-title: calc(36s / var(--speed));
    }
  }

  .sw__stars {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
  }

  /* ---------- Beat 1: the story crawl ---------- */

  .sw__viewport {
    position: absolute;
    inset: 0;
    z-index: 2; /* above the title, so the story passes in front of it */
    overflow: hidden;
    pointer-events: none;
    perspective: var(--crawl-perspective);
    perspective-origin: 50% var(--vanish);
    /* Distance haze, not a cut. The story stays at full strength through the
       lower half, then dims steadily over the upper third as it recedes, and
       is gone before it reaches the horizon. The top of the slab ends as a
       soft flat edge, which keeps the whole crawl reading as a trapezoid
       instead of converging to a point. The stops ease out so the dimming
       has no visible band. */
    --haze: linear-gradient(
      to top,
      #000 0%,
      #000 58%,
      rgba(0, 0, 0, 0.85) 64%,
      rgba(0, 0, 0, 0.62) 70%,
      rgba(0, 0, 0, 0.38) 76%,
      rgba(0, 0, 0, 0.17) 81%,
      rgba(0, 0, 0, 0) 86%
    );
    -webkit-mask-image: var(--haze);
    mask-image: var(--haze);
  }

  .sw__crawl {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    margin: 0 auto;
    /* A wide slab with tight paragraph gaps, so the tilt turns it into one
       solid trapezoid rather than a stack of separate blocks */
    width: min(90vw, 1000px);
    transform-origin: 50% 100%;
    transform: rotateX(var(--tilt)) translateY(var(--crawl-from));
    will-change: transform;
    color: var(--story-color);
    font-family: 'News Cycle', 'Franklin Gothic Medium', system-ui, sans-serif;
    font-weight: 700;
    font-size: clamp(1.05rem, 3.9vw, 2.45rem);
    line-height: 1.4;
    text-align: justify;
    hyphens: auto;
    -webkit-hyphens: auto;
    text-wrap: pretty;
    text-shadow: 0 0 6px rgba(253, 188, 28, 0.35), 0 0 22px rgba(253, 188, 28, 0.3);
    opacity: 0;
  }

  .sw.is-playing .sw__crawl {
    animation: sw-crawl var(--t-crawl) linear var(--t-crawl-delay) both;
  }

  /* The hand-off. With the title riding right behind the story, the story's
     tail is still up where the title lands, so the story dissolves just
     before the title comes forward. On wide screens it is already deep in
     the haze by then; on tall ones this clears the landing spot. */
  .sw.is-playing .sw__viewport {
    animation: sw-story-out calc(var(--t-title) * 0.1) ease-in calc(var(--t-title-delay) + var(--t-title) * 0.58) both;
  }

  @keyframes sw-story-out {
    to { opacity: 0; }
  }

  /* Opacity is pinned at 1 the whole way. The story leaves by receding, not
     by fading: it shrinks as it climbs the plane and converges on the
     vanishing point, and is a few pixels tall by the time the mask takes it. */
  @keyframes sw-crawl {
    0% {
      opacity: 1;
      transform: rotateX(var(--tilt)) translateY(var(--crawl-from));
    }
    100% {
      opacity: 1;
      transform: rotateX(var(--tilt)) translateY(var(--crawl-to));
    }
  }

  .sw__crawl p { margin: 0 0 0.7em; }
  .sw__crawl p:last-child { margin-bottom: 0; }

  /* Justified edges stay straight; a paragraph's short last line sits on the
     centre line, as in the film, instead of notching the left edge */
  .sw__para { text-align-last: center; }

  .sw__episode,
  .sw__subtitle {
    text-align: center;
    text-transform: uppercase;
  }

  .sw__episode { letter-spacing: 0.12em; }

  .sw__subtitle {
    margin-bottom: 1em;
    letter-spacing: 0.06em;
  }

  .sw__names {
    text-align: center;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 0.7em;
    margin-top: 1.4em;
  }

  /* ---------- Beat 2: TECH TEAM ---------- */

  .sw__title-layer {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: grid;
    place-items: center;
    pointer-events: none;
    perspective: var(--perspective);
    perspective-origin: 50% var(--vanish);
  }

  .sw__title {
    margin: 0;
    text-align: center;
    font-family: 'Star Jedi', 'Anton', 'Haettenschweiler', 'Arial Narrow', sans-serif;
    font-weight: 400;
    font-size: min(24vw, 24vh);
    line-height: var(--title-leading);
    letter-spacing: 0.04em;
    text-indent: 0.04em; /* balance out the trailing letter-space */
    color: var(--yellow);
    text-shadow: 0 0 34px rgba(254, 218, 74, 0.25);
    opacity: 0;
    will-change: transform, color;
    transition: transform 0.5s ease, color 0.5s ease, text-shadow 0.5s ease;
  }

  /* Undistorted by default; see --title-stretch-x/y */
  .sw__title-line {
    display: block;
    transform: scale(var(--title-stretch-x), var(--title-stretch-y));
  }

  .sw.is-playing .sw__title {
    animation: sw-title var(--t-title) var(--t-title-delay) both;
  }

  @keyframes sw-title {
    /* Riding up the crawl plane behind the story, drifting away from camera */
    0% {
      animation-timing-function: linear;
      opacity: 1;
      color: var(--yellow);
      text-shadow: 0 0 34px rgba(254, 218, 74, 0.25);
      transform: rotateX(var(--tilt)) translateY(var(--title-from)) translateZ(var(--title-from-z));
    }
    /* Arrived at screen centre, still lying back on the plane */
    70% {
      animation-timing-function: cubic-bezier(0.22, 0.8, 0.24, 1);
      opacity: 1;
      color: var(--yellow);
      text-shadow: 0 0 34px rgba(254, 218, 74, 0.25);
      transform: rotateX(var(--tilt)) translateY(-14.5vh) translateZ(var(--title-depth));
    }
    /* Flattened square to the camera, and a different colour */
    92%,
    100% {
      opacity: 1;
      color: var(--title-color-end);
      text-shadow: 0 0 60px rgba(75, 213, 238, 0.45);
      transform: rotateX(0deg) translateY(var(--title-rest)) translateZ(0);
    }
  }

  /* The flatten-and-turn-blue beat starts 70% into the title's timeline. The
     cue's own animation starts on exactly that beat, and its animationstart
     is what tells the page. Built from the same vars, so --speed keeps the
     two in step. */
  .sw__cue {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
  }

  .sw.is-playing .sw__cue {
    animation: sw-cue 1ms linear calc(var(--t-title-delay) + var(--t-title) * 0.7) both;
  }

  @keyframes sw-cue {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  /* Resting state — also where "Skip" lands you */
  .sw.is-done .sw__title {
    opacity: 1;
    color: var(--title-color-end);
    text-shadow: 0 0 60px rgba(75, 213, 238, 0.45);
    transform: rotateX(0deg) translateY(var(--title-rest)) translateZ(0);
  }

  /* ---------- Outro ---------- */

  .sw__outro {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 12vh;
    z-index: 3;
    padding: 0 1rem;
    text-align: center;
    opacity: 0;
    visibility: hidden;
    transition: opacity 1.2s ease;
  }

  .sw.is-done .sw__outro {
    opacity: 1;
    visibility: visible;
  }

  .sw__tagline {
    margin: 0;
    color: var(--title-color-end);
    font-family: 'News Cycle', system-ui, sans-serif;
    font-weight: 700;
    letter-spacing: 0.5em;
    text-indent: 0.5em;
    font-size: clamp(0.75rem, 1.6vw, 1.05rem);
    text-transform: uppercase;
  }

  .sw__actions { margin-top: 1.4rem; }
  .sw__actions:empty { display: none; }

  /* No scrolling while the sequence runs; the script sets and clears this.
     --intro-lock-lane pads the space a hidden scrollbar leaves, so the page
     doesn't widen and then jump back when the lock lifts. */
  :global(:root.is-intro-locked) {
    overflow: hidden;
    padding-right: var(--intro-lock-lane, 0px);
  }

  /* ---------- Controls ---------- */

  .sw__controls {
    position: absolute;
    right: clamp(0.75rem, 2vw, 1.75rem);
    bottom: clamp(0.75rem, 2vw, 1.75rem);
    z-index: 5;
    display: flex;
    gap: 0.5rem;
  }

  .sw__hud {
    position: absolute;
    right: clamp(0.75rem, 2vw, 1.75rem);
    top: clamp(0.75rem, 2vw, 1.75rem);
    z-index: 5;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.6rem;
    transition: transform 1.1s cubic-bezier(0.22, 0.8, 0.24, 1);
  }

  /* When the site navbar comes down, the HUD steps down with it rather than
     sitting underneath. --nav-h comes from the navbar; with no navbar on the
     page it is unset and nothing moves. */
  :global(:root:not([data-intro='playing'])) .sw__hud,
  :global(:root:has([data-site-nav]:focus-within)) .sw__hud {
    transform: translateY(var(--nav-h, 0px));
  }

  /* On a phone the navbar's Menu pill owns the top-right corner, so once the
     sequence lands Replay leaves it for the end card, under the year, and
     fades in with it. */
  @media (max-width: 47.99rem) {
    .sw.is-done .sw__hud {
      top: auto;
      left: 0;
      right: 0;
      bottom: max(1rem, calc(12vh - 3.3rem));
      align-items: center;
      transform: none;
      transition: none;
      animation: sw-hud-in 1.2s ease both;
    }
  }

  @keyframes sw-hud-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  .sw__btn {
    background: transparent;
    border: 1px solid rgba(254, 218, 74, 0.35);
    border-radius: 999px;
    color: rgba(254, 218, 74, 0.75);
    font-family: 'News Cycle', system-ui, sans-serif;
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 0.45rem 0.95rem;
    cursor: pointer;
    transition: color 0.2s, border-color 0.2s, background 0.2s;
  }

  .sw__btn:hover,
  .sw__btn:focus-visible {
    color: #000;
    background: var(--yellow);
    border-color: var(--yellow);
  }

  /* ---------- Speed dial ---------- */

  .sw__speed {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.3rem;
    width: clamp(7rem, 14vw, 9.5rem);
    color: rgba(254, 218, 74, 0.75);
    font-family: 'News Cycle', system-ui, sans-serif;
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .sw__speed-head {
    display: flex;
    gap: 0.4rem;
  }

  .sw__speed-value {
    color: var(--yellow);
    font-variant-numeric: tabular-nums;
  }

  .sw__speed-range {
    -webkit-appearance: none;
    appearance: none;
    width: 100%;
    height: 0.9rem;
    margin: 0;
    background: transparent;
    cursor: pointer;
  }

  /* Track and thumb need vendor twins — the shorthands are not shared. */
  .sw__speed-range::-webkit-slider-runnable-track {
    height: 2px;
    border-radius: 2px;
    background: rgba(254, 218, 74, 0.35);
  }

  .sw__speed-range::-moz-range-track {
    height: 2px;
    border-radius: 2px;
    background: rgba(254, 218, 74, 0.35);
  }

  .sw__speed-range::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 0.7rem;
    height: 0.7rem;
    margin-top: -0.3rem; /* centre the thumb on the 2px track */
    border-radius: 50%;
    border: none;
    background: var(--yellow);
    transition: transform 0.15s;
  }

  .sw__speed-range::-moz-range-thumb {
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 50%;
    border: none;
    background: var(--yellow);
    transition: transform 0.15s;
  }

  .sw__speed-range:hover::-webkit-slider-thumb { transform: scale(1.25); }
  .sw__speed-range:hover::-moz-range-thumb { transform: scale(1.25); }

  .sw__speed-range:focus-visible {
    outline: 1px solid var(--yellow);
    outline-offset: 0.35rem;
    border-radius: 999px;
  }

  /* One button in the top-right slot at a time, and the dial only while
     there is something running for it to re-time. Its value is kept, so a
     Replay picks up at whatever speed was last dialled in. */
  .sw:not(.is-playing) .sw__btn[data-action='skip'] { display: none; }
  .sw.is-playing .sw__btn[data-action='replay'] { display: none; }
  .sw:not(.is-playing) .sw__speed { display: none; }

  /* ---------- Reduced motion ---------- */

  @media (prefers-reduced-motion: reduce) {
    .sw__viewport { display: none; }

    .sw__title {
      transition: none;
      opacity: 1;
    }

    .sw__outro { transition: none; }

    .sw__controls { display: none; }
    .sw__hud { display: none; }
  }
</style>

<script>
  function initStarWarsHero() {
    const root = document.getElementById('tech-team-hero');
    if (!root || root.dataset.ready === 'true') return;
    root.dataset.ready = 'true';

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    /* ---- Starfield: the field rushes past the camera at warp ---- */
    const canvas = root.querySelector('.sw__stars') as HTMLCanvasElement | null;
    const ctx = canvas ? canvas.getContext('2d') : null;

    if (canvas && ctx) {
      type Star = { x: number; y: number; z: number };
      const DEPTH = 2000; // how far back the field is seeded
      const FOCAL = 300; // projection distance; larger spreads stars wider
      const WARP = 5; // units of depth travelled per frame
      // A star is drawn as the segment it swept, from where it was TRAIL units
      // of depth ago to where it is now. Perspective does the rest: far stars
      // are near-points, close ones stretch into long streaks.
      const TRAIL = WARP * 9;
      let stars: Star[] = [];
      let w = 0;
      let h = 0;
      let rafId = 0;

      const place = (s: Star, z: number) => {
        s.x = (Math.random() - 0.5) * DEPTH;
        s.y = (Math.random() - 0.5) * DEPTH;
        s.z = z;
      };

      const seed = () => {
        const dpr = Math.min(window.devicePixelRatio || 1, 2);
        w = canvas.clientWidth;
        h = canvas.clientHeight;
        canvas.width = Math.round(w * dpr);
        canvas.height = Math.round(h * dpr);
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        ctx.fillStyle = '#000';
        ctx.fillRect(0, 0, w, h);

        const count = w < 768 ? 200 : 450;
        stars = Array.from({ length: count }, () => {
          const s: Star = { x: 0, y: 0, z: 0 };
          place(s, Math.random() * DEPTH + 1);
          return s;
        });
      };

      const paint = (advance: boolean) => {
        if (advance) {
          // The streaks carry the motion now, so the frame only needs a light
          // persistence to soften their leading edge, not to fake length.
          ctx.fillStyle = 'rgba(0, 0, 0, 0.6)';
        } else {
          ctx.fillStyle = '#000';
        }
        ctx.fillRect(0, 0, w, h);

        const cx = w / 2;
        const cy = h / 2;
        ctx.fillStyle = '#fff';
        ctx.strokeStyle = '#fff';
        ctx.lineCap = 'round';

        for (const s of stars) {
          if (advance) {
            s.z -= WARP;
            if (s.z <= 1) place(s, DEPTH);
          }

          const k = FOCAL / s.z;
          const px = cx + s.x * k;
          const py = cy + s.y * k;
          // Off screen by more than a streak's worth: nothing to draw.
          if (px < -w || px > w * 2 || py < -h || py > h * 2) continue;

          ctx.globalAlpha = Math.min(1, k * 1.6);

          if (!advance) {
            // Still field: points, not streaks. Nothing has swept anywhere.
            ctx.fillRect(px - 0.5, py - 0.5, 1, 1);
            continue;
          }

          // Tail sits where the star was one TRAIL ago, which is always
          // nearer the vanishing point, so streaks radiate outward.
          const kTail = FOCAL / (s.z + TRAIL);
          const tx = cx + s.x * kTail;
          const ty = cy + s.y * kTail;

          const len = Math.hypot(px - tx, py - ty);
          if (len < 0.8) {
            // Too far out to have swept a visible distance: a dim point.
            ctx.fillRect(px - 0.5, py - 0.5, 1, 1);
            continue;
          }

          ctx.lineWidth = Math.min(2.4, Math.max(0.6, 1.5 * k));
          ctx.beginPath();
          ctx.moveTo(tx, ty);
          ctx.lineTo(px, py);
          ctx.stroke();
        }
        ctx.globalAlpha = 1;
      };

      const loop = () => {
        paint(true);
        rafId = requestAnimationFrame(loop);
      };

      seed();

      if (reduced) {
        paint(false); // a still field, no rush
      } else {
        loop();
      }

      let resizeTimer = 0;
      window.addEventListener('resize', () => {
        window.clearTimeout(resizeTimer);
        resizeTimer = window.setTimeout(() => {
          seed();
          if (reduced) paint(false);
        }, 150);
      });

      document.addEventListener('visibilitychange', () => {
        if (reduced) return;
        if (document.hidden) {
          cancelAnimationFrame(rafId);
        } else {
          rafId = requestAnimationFrame(loop);
        }
      });
    }

    /* ---- Sequence control ----
       <html data-intro> tells the rest of the page where the sequence is:
       "playing", then "landing" as the title starts turning blue, then
       "done". The site navbar keys its entrance off it. */
    const page = document.documentElement;
    const title = root.querySelector('.sw__title');
    const cue = root.querySelector('.sw__cue');
    const audio = root.querySelector('.sw__audio') as HTMLAudioElement | null;
    const soundBtn = root.querySelector('[data-action="sound"]');
    const soundLabel = root.querySelector('[data-sound-label]');

    /* The page does not scroll until the sequence has ended or been skipped.
       The lock is set here, never by the server, so a script that fails to
       run cannot trap anyone on the intro. */
    const lock = () => {
      if (page.classList.contains('is-intro-locked')) return;
      const before = page.clientWidth;
      page.classList.add('is-intro-locked');
      const lane = page.clientWidth - before; // width of a classic scrollbar, else 0
      page.style.setProperty('--intro-lock-lane', `${Math.max(0, lane)}px`);
    };

    const unlock = () => {
      page.classList.remove('is-intro-locked');
      page.style.removeProperty('--intro-lock-lane');
    };

    const finish = () => {
      root.classList.remove('is-playing');
      root.classList.add('is-done');
      page.dataset.intro = 'done';
      unlock();
    };

    const play = () => {
      window.scrollTo({ top: 0, behavior: 'instant' });
      lock();
      root.classList.remove('is-done', 'is-playing');
      void root.offsetWidth; // force a reflow so the animations restart
      root.classList.add('is-playing');
      page.dataset.intro = 'playing';
    };

    const skip = () => {
      if (audio) audio.pause();
      finish();
    };

    // The title is the last thing to settle, so it owns the end of the sequence.
    if (title) title.addEventListener('animationend', finish);
    if (cue) cue.addEventListener('animationstart', () => (page.dataset.intro = 'landing'));

    const skipBtn = root.querySelector('[data-action="skip"]');
    if (skipBtn) skipBtn.addEventListener('click', skip);

    // Choosing a section in the navbar ends the intro first, so the jump to
    // it is not scrolling past a sequence that is still running.
    document.addEventListener('intro:skip', () => {
      if (root.classList.contains('is-playing')) skip();
    });

    /* The slider drives --speed, which every duration in the stylesheet
       divides by, so one value re-times the whole sequence. The audio is
       retimed to match so a fanfare stays lined up with the visuals. */
    const speedRange = root.querySelector('[data-action="speed"]') as HTMLInputElement | null;
    const speedOut = root.querySelector('[data-speed-out]');

    if (speedRange) {
      const applySpeed = () => {
        const v = Number(speedRange.value);
        root.style.setProperty('--speed', String(v));
        if (speedOut) speedOut.textContent = v.toFixed(1) + '×';
        // playbackRate is clamped to what the browser will resample cleanly
        if (audio) audio.playbackRate = Math.min(4, Math.max(0.5, v));
      };
      speedRange.addEventListener('input', applySpeed);
      applySpeed();
    }

    const replayBtn = root.querySelector('[data-action="replay"]');
    if (replayBtn) {
      replayBtn.addEventListener('click', () => {
        if (audio && soundBtn && soundBtn.getAttribute('aria-pressed') === 'true') {
          audio.currentTime = 0;
          audio.play().catch(() => {});
        }
        play();
      });
    }

    if (audio && soundBtn) {
      soundBtn.addEventListener('click', () => {
        const on = soundBtn.getAttribute('aria-pressed') === 'true';
        if (on) {
          audio.pause();
          soundBtn.setAttribute('aria-pressed', 'false');
          if (soundLabel) soundLabel.textContent = 'Play with sound';
        } else {
          audio.currentTime = 0;
          audio.play().catch(() => {});
          soundBtn.setAttribute('aria-pressed', 'true');
          if (soundLabel) soundLabel.textContent = 'Mute';
          play(); // restart the visuals so they line up with the music
        }
      });
    }

    // A reload always restarts the intro, so it should start at the top
    // rather than wherever the page was left.
    if ('scrollRestoration' in history) history.scrollRestoration = 'manual';

    // A link straight to a section (#crew) lands on that section: the visitor
    // asked to be somewhere else, and the page can't scroll while it plays.
    let deepLink = false;
    try {
      const target = location.hash.length > 1 && document.getElementById(decodeURIComponent(location.hash.slice(1)));
      deepLink = !!target && !root.contains(target);
    } catch {}

    if (reduced || deepLink) {
      finish();
    } else {
      play();
    }
  }

  initStarWarsHero();
  document.addEventListener('astro:page-load', initStarWarsHero);
</script>
